# Tavily Search API Key (Obtain from https://tavily.com)
TAVILY_API_KEY=tvly-...

# Groq API Key (Obtain from https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Gemini API Key (Optional for embeddings fallback: Obtain from Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Application Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Persistent RAG cache configuration
CACHE_DB_PATH=cache/rag_cache.db
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=10
EXACT_ANSWER_TTL=86400
SEMANTIC_CACHE_TTL=86400
SEARCH_CACHE_TTL=86400
PAGE_CACHE_TTL=604800
SEMANTIC_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TOP_K=5
KNOWLEDGE_REUSE_MIN_SIMILARITY=0.75

# MongoDB persistent store & application history
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sourceiq_rag
JWT_SECRET=change_this_to_a_secure_random_secret_key


